{
  "functions": {
    "api/sitemap.js": {
      "includeFiles": "public/sitemap-static.xml"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "s"
        }
      ],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dca-to-bwi-airport",
      "destination": "/dca-to-bwi",
      "permanent": true
    },
    {
      "source": "/dca-to-tysons-corner",
      "destination": "/dca-to-tysons",
      "permanent": true
    },
    {
      "source": "/dca-to-mclean-va",
      "destination": "/dca-to-mclean",
      "permanent": true
    },
    {
      "source": "/dca-to-reston-va",
      "destination": "/dca-to-reston",
      "permanent": true
    },
    {
      "source": "/dca-to-herndon-va",
      "destination": "/dca-to-herndon",
      "permanent": true
    },
    {
      "source": "/dca-to-fredericksburg-va",
      "destination": "/dca-to-fredericksburg",
      "permanent": true
    },
    {
      "source": "/dca-to-rockville-md",
      "destination": "/dca-to-rockville",
      "permanent": true
    },
    {
      "source": "/capstone-limo-service",
      "destination": "/cape-st-claire-limo-service",
      "permanent": true
    },
    {
      "source": "/snopesville-limo-service",
      "destination": "/sykesville-limo-service",
      "permanent": true
    },
    {
      "source": "/blog/corporate-transportation-dc-executive-guide",
      "destination": "/blog/dc-corporate-transportation-guide",
      "permanent": true
    },
    {
      "source": "/blog/luxury-wedding-transportation-planning",
      "destination": "/blog/dc-wedding-transportation-guide",
      "permanent": true
    },
    {
      "source": "/blog/chauffeur-vs-rideshare-business-travelers",
      "destination": "/corporate-car-service-vs-rideshare",
      "permanent": true
    },
    {
      "source": "/blog/dc-corporate-events-transportation-logistics",
      "destination": "/blog/dc-corporate-transportation-guide",
      "permanent": true
    },
    {
      "source": "/blog/luxury-ground-transportation-trends-2025",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/images/:name([^/]+)\\.(jpg|jpeg|png)",
      "destination": "/images/:name.webp",
      "permanent": true
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/shell.html"
    }
  ]
}
